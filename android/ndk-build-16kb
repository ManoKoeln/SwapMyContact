#!/bin/bash
# NDK build wrapper that forces 16 KB page size

ANDROID_NDK_HOME="/Users/matthias/Library/Android/sdk/ndk/27.0.12077973"

# Set environment variables
export LDFLAGS="-Wl,-z,max-page-size=16384 $LDFLAGS"
export CFLAGS="-Wl,-z,max-page-size=16384 $CFLAGS"
export CXXFLAGS="-Wl,-z,max-page-size=16384 $CXXFLAGS"

# Execute ndk-build
exec "$ANDROID_NDK_HOME/ndk-build" "$@"
